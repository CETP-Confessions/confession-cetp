rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function superAdmin() { return signedIn() && request.auth.token.role == 'super_admin'; }
    function destination(destinationId) {
      return get(/databases/$(database)/documents/destinations/$(destinationId)).data;
    }
    function ownsDestination(destinationId) {
      return signedIn() && destination(destinationId).ownerId == request.auth.uid;
    }
    function managesOrganization(organizationId) {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'organization_admin'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organizationId == organizationId;
    }
    function canManageDestination(destinationId) {
      let target = destination(destinationId);
      return signedIn() && (target.ownerId == request.auth.uid || superAdmin()
        || (target.organizationId != null && managesOrganization(target.organizationId)));
    }
    function canManageDestinationData(target) {
      return signedIn() && (target.ownerId == request.auth.uid || superAdmin()
        || (target.organizationId != null && managesOrganization(target.organizationId)));
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || superAdmin());
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.role == 'user'
        && request.resource.data.active == true
        && request.resource.data.keys().hasOnly(['username', 'displayName', 'email', 'role', 'active', 'createdAt']);
      allow update: if signedIn() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'fcmTokens']);
      allow delete: if superAdmin();
    }

    match /organizations/{organizationId} {
      allow get: if resource.data.active == true || managesOrganization(organizationId) || superAdmin();
      allow list: if resource.data.active == true || superAdmin();
      allow write: if superAdmin();
    }

    match /destinations/{destinationId} {
      allow get, list: if canManageDestinationData(resource.data);
      allow write: if superAdmin();
    }

    match /messages/{messageId} {
      allow get, list: if canManageDestination(resource.data.destinationId);
      allow create, update, delete: if false;
    }

    match /reports/{reportId} {
      allow get, list: if superAdmin() || canManageDestination(resource.data.destinationId);
      allow create, update, delete: if false;
    }

    match /moderationQueue/{messageId} { allow read, write: if false; }

    match /blockedWords/{wordId} {
      allow read: if superAdmin();
      allow write: if superAdmin();
    }

    match /conversations/{conversationId}/{document=**} {
      allow read, write: if false;
    }

    match /uploadRequests/{requestId} { allow read, write: if false; }
    match /_rateLimits/{document=**} { allow read, write: if false; }
    match /_destinationSlugs/{slug} { allow read, write: if false; }
    match /messageFingerprints/{fingerprint} { allow read, write: if false; }
  }
}